# AutoAnalyst AI — Centralized LLM & OpenRouter Configuration
# Copy this file to .env and configure your secrets.
# NEVER commit .env to version control.

# Master LLM Switch
AUTOANALYST_LLM_ENABLED=true
AUTOANALYST_LLM_PROVIDER=openrouter

# OpenRouter Central Gateway Configuration
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_FALLBACK_MODEL=anthropic/claude-3.5-haiku
OPENROUTER_TIMEOUT=60
OPENROUTER_MAX_RETRIES=3
OPENROUTER_TEMPERATURE=0.2
OPENROUTER_MAX_TOKENS=2048
OPENROUTER_SITE_URL=https://github.com/GhariebML/AutoAnalyst-AI
OPENROUTER_APP_NAME=AutoAnalyst AI

# Legacy Provider Keys (Optional Fallbacks)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
